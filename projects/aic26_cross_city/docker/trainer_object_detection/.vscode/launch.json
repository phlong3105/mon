{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Model training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train.py",
            "args": [
                // "--model", "RFDETRSegPreview", // RFDETRNano, RFDETRSmall, RFDETRMedium, RFDETRLarge, RFDETRSegPreview
                //"--batch_size", "2",
                "--epochs", "1",
                "--inference-config.threshold", "0.04",
                //"--stop_early", // Breaks script before training starts. Can be used to avoid long training times during testing.
            ],
        },
        {
            "name": "Visualize Predictions",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/visualize.py",
            "args": [
                "--model-path", "./pretrained_models/RFDETRNano.zip", // RFDETRNano, RFDETRSmall, RFDETRMedium, RFDETRLarge, RFDETRSegPreview
                // "--model-path", "./checkpoint_models/vehicle_only", // vehicle_only
                "--inference.threshold", "0.35",

            ],
        },
        {
            "name": "Model benchmark (pretrained)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/benchmark.py",
            "args": [
                "--model-path", "./pretrained_models/RFDETRNano.zip", // RFDETRNano, RFDETRSmall, RFDETRMedium, RFDETRLarge, RFDETRSegPreview
                "--dataset-class-mapping", "Midwest2OnlyVehicle",
                "--model-class-mapping", "COCO2OnlyVehicle",
                "--samples", "10"
            ],
        },
        {
            "name": "Model Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/benchmark.py",
            "args": [
                "--model-path", "./pretrained_models/RFDETRNano.zip", // RFDETRNano, RFDETRSmall, RFDETRMedium, RFDETRLarge, RFDETRSegPreview
                "--model-class-mapping", "COCO2OnlyVehicle",
                "--output-path", "./.data/inference_output",
                "--samples", "10"
            ],
        }
    ]
}